-- Add price_cents to availability and basic RLS policies for availability and bookings

alter table availability
  add column if not exists price_cents integer;

-- Enable row level security
alter table availability enable row level security;
alter table bookings enable row level security;

-- Availability: coaches can insert/update/delete their own rows; public can select
drop policy if exists "availability_public_select" on availability;
create policy "availability_public_select" on availability
  for select using (true);

drop policy if exists "availability_coach_modify" on availability;
create policy "availability_coach_modify" on availability
  for all using (auth.role() = 'authenticated' and auth.uid() = coach_id)
  with check (auth.uid() = coach_id);

-- Bookings: users can insert bookings for themselves; users and coaches can select their bookings
drop policy if exists "bookings_user_insert" on bookings;
create policy "bookings_user_insert" on bookings
  for insert with check (auth.role() = 'authenticated' and auth.uid() = user_id);

drop policy if exists "bookings_user_select" on bookings;
create policy "bookings_user_select" on bookings
  for select using (auth.role() = 'authenticated' and (auth.uid() = user_id or auth.uid() = coach_id));

drop policy if exists "bookings_update_by_coach" on bookings;
create policy "bookings_update_by_coach" on bookings
  for update using (auth.role() = 'authenticated' and auth.uid() = coach_id)
  with check (auth.uid() = coach_id);

-- Note: adjust policies for admin roles as needed.
